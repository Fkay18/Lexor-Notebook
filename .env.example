# Copy this file to .env and fill in unique secrets for your environment.
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Set your deployed domain(s) and HTTPS origin before production.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Set a positive HSTS duration only after verifying HTTPS works end-to-end.
# SECURE_HSTS_SECONDS=31536000
# Enable these only if every affected domain/subdomain is HTTPS-only.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true

# Use a dedicated MySQL account with access only to the application database.
DB_NAME=noteapp_db
DB_USER=noteapp_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Optional SMTP settings. For Gmail, use an app password.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=
